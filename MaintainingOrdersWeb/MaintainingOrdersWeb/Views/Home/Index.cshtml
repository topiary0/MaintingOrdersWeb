@{
    ViewData["Title"] = "Дашборд";
}

<div class="hero-panel mb-4">
    <div>
        <h1>Система управления оптовыми заказами</h1>
        <p class="lead mb-0">Добро пожаловать, <strong>@ViewBag.UserName</strong>. Рабочий дашборд адаптирован под ваши задачи.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="metric-card"><div class="metric-title">Заказы</div><div class="metric-value">@(ViewBag.TotalOrders ?? 0)</div></div></div>
    <div class="col-md-3"><div class="metric-card"><div class="metric-title">Выручка</div><div class="metric-value">@(ViewBag.TotalRevenue?.ToString("N2") ?? "0.00") ₽</div></div></div>
    <div class="col-md-3"><div class="metric-card"><div class="metric-title">Товары</div><div class="metric-value">@(ViewBag.TotalProducts ?? 0)</div></div></div>
    <div class="col-md-3"><div class="metric-card"><div class="metric-title">Клиенты</div><div class="metric-value">@(ViewBag.TotalClients ?? 0)</div></div></div>
</div>

@if (User.IsInRole("Директор"))
{
    <div class="glass-card p-3 mb-4">
        <h3 class="mb-3">Дашборд директора</h3>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="mini-card">
                    <h5>Последние сделки</h5>
                    <p class="text-muted">Контроль динамики заказов и выручки.</p>
                    <a class="btn btn-primary btn-sm" asp-controller="Orders" asp-action="Index">Открыть все заказы</a>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mini-card">
                    <h5>Управление сотрудниками</h5>
                    <p class="text-muted">Роли, доступы и структура команды.</p>
                    <a class="btn btn-outline-primary btn-sm" asp-controller="Users" asp-action="Index">Пользователи</a>
                </div>
            </div>
        </div>
    </div>
}

@if (User.IsInRole("Менеджер"))
{
    <div class="glass-card p-3 mb-4">
        <h3 class="mb-3">Дашборд менеджера по продажам</h3>
        <div class="row g-3">
            <div class="col-md-4"><a class="quick-tile" asp-controller="Products" asp-action="Index">Проверить остатки</a></div>
            <div class="col-md-4"><a class="quick-tile" asp-controller="Orders" asp-action="Create">Оформить новый заказ</a></div>
            <div class="col-md-4"><a class="quick-tile" asp-controller="Clients" asp-action="Index">База клиентов</a></div>
        </div>
    </div>
}

@if (User.IsInRole("Логист"))
{
    <div class="glass-card p-3 mb-4">
        <h3 class="mb-3">Дашборд логиста</h3>
        <p class="text-muted">Активные поставки и планирование доставки.</p>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-primary btn-sm" asp-controller="Shipment" asp-action="Index">Активные поставки</a>
            <a class="btn btn-outline-primary btn-sm" asp-controller="DeliveryMethods" asp-action="Index">Способы доставки</a>
            <a class="btn btn-outline-primary btn-sm" asp-controller="Orders" asp-action="Index">Заказы к доставке</a>
        </div>
    </div>
}

@if (User.IsInRole("Сотрудник"))
{
    <div class="glass-card p-3 mb-4">
        <h3 class="mb-3">Дашборд склада</h3>
        <p class="text-muted">План отгрузок, приоритеты и обновление остатков.</p>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-primary btn-sm" asp-controller="Orders" asp-action="Index">Заказы на сборку</a>
            <a class="btn btn-outline-primary btn-sm" asp-controller="OrderItems" asp-action="Index">Составы заказов</a>
            <a class="btn btn-outline-primary btn-sm" asp-controller="Products" asp-action="Index">Остатки товаров</a>
        </div>
    </div>
}

@if (User.IsInRole("Бухгалтер"))
{
    <div class="glass-card p-3 mb-4">
        <h3 class="mb-3">Дашборд бухгалтера</h3>
        <p class="text-muted">Единые документы заказов и контроль сумм.</p>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-primary btn-sm" asp-controller="Orders" asp-action="Index">Реестр заказов</a>
            <a class="btn btn-outline-primary btn-sm" asp-controller="Clients" asp-action="Index">Контрагенты</a>
            <a class="btn btn-outline-primary btn-sm" asp-controller="Products" asp-action="Index">Товары и цены</a>
        </div>
    </div>
}

<div class="glass-card p-3">
    <h3 class="mb-3">Последние заказы</h3>
    @if (ViewBag.RecentOrders != null && ViewBag.RecentOrders.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-modern align-middle">
                <thead>
                    <tr><th>#</th><th>Дата</th><th>Клиент</th><th>Статус</th><th>Сумма</th></tr>
                </thead>
                <tbody>
                    @foreach (var order in ViewBag.RecentOrders)
                    {
                        <tr>
                            <td>@order.OrderId</td>
                            <td>@order.OrderDate</td>
                            <td>@(order.Client?.Name ?? "-")</td>
                            <td>@(order.Status?.StatusName ?? "-")</td>
                            <td>@order.TotalPrice</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted mb-0">Пока нет заказов для отображения.</p>
    }
</div>
