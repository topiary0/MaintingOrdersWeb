@using System.Text.Json
@{
    ViewData["Title"] = "Главная";
}

<div class="hero-panel mb-4">
    <h1 class="mb-0">Добро пожаловать, @ViewBag.UserName</h1>
</div>

@if (User.IsInRole("Директор"))
{
    <div class="glass-card p-3 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h3 class="mb-0">Панель директора</h3>
            <div class="d-flex gap-2">
                <a class="btn btn-sm btn-primary" asp-controller="Reports" asp-action="Index">Отчёты</a>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Users" asp-action="Index">Пользователи</a>
            </div>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-3"><div class="metric-card"><div class="metric-title">Выручка</div><div class="metric-value">@(ViewBag.TotalRevenue?.ToString("N2") ?? "0.00") ₽</div></div></div>
            <div class="col-md-3"><div class="metric-card"><div class="metric-title">Заказов</div><div class="metric-value">@ViewBag.TotalOrders</div></div></div>
            <div class="col-md-3"><div class="metric-card"><div class="metric-title">Клиенты</div><div class="metric-value">@ViewBag.TotalClients</div></div></div>
            <div class="col-md-3"><div class="metric-card"><div class="metric-title">Товары</div><div class="metric-value">@ViewBag.TotalProducts</div></div></div>
        </div>

        <div style="max-width: 700px; height: 190px;">
            <canvas id="directorChart"></canvas>
        </div>
    </div>
}

@if (User.IsInRole("Менеджер"))
{
    <div class="glass-card p-3 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h3 class="mb-0">Панель менеджера</h3>
            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-sm btn-primary" asp-controller="Orders" asp-action="Create">Новый заказ</a>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Clients" asp-action="Create">Новый клиент</a>
            </div>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-3"><a class="quick-tile" asp-controller="Orders" asp-action="Index">Реестр заказов</a></div>
            <div class="col-md-3"><a class="quick-tile" asp-controller="OrderItems" asp-action="Index">Составы заказов</a></div>
            <div class="col-md-3"><a class="quick-tile" asp-controller="Shipment" asp-action="Index">Поставки</a></div>
            <div class="col-md-3"><a class="quick-tile" asp-controller="SupplyItems" asp-action="Index">Составы поставок</a></div>
        </div>

        <div style="max-width: 560px; height: 190px;">
            <canvas id="managerChart"></canvas>
        </div>
    </div>
}

@if (User.IsInRole("Логист"))
{
    <div class="glass-card p-3 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h3 class="mb-0">Панель логиста</h3>
            <a class="btn btn-sm btn-outline-primary" asp-controller="DeliveryMethods" asp-action="Index">Способы доставки</a>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-4"><a class="quick-tile" asp-controller="Orders" asp-action="Index">Заказы к доставке</a></div>
            <div class="col-md-4"><a class="quick-tile" asp-controller="OrderItems" asp-action="Index">Состав заказов</a></div>
            <div class="col-md-4"><a class="quick-tile" asp-controller="Products" asp-action="Index">Остатки товаров</a></div>
        </div>

        <div style="max-width: 700px; height: 190px;">
            <canvas id="logisticChart"></canvas>
        </div>
    </div>
}

@if (User.IsInRole("Сотрудник"))
{
    <div class="glass-card p-3 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h3 class="mb-0">Панель склада</h3>
            <a class="btn btn-sm btn-primary" asp-controller="Orders" asp-action="Index">В работу</a>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-6"><a class="quick-tile" asp-controller="Orders" asp-action="Index">Заказы на сборку</a></div>
            <div class="col-md-6"><a class="quick-tile" asp-controller="OrderItems" asp-action="Index">Состав заказов</a></div>
        </div>

        <div style="max-width: 700px; height: 190px;">
            <canvas id="employeeChart"></canvas>
        </div>
    </div>
}

@if (User.IsInRole("Бухгалтер"))
{
    <div class="glass-card p-3 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h3 class="mb-0">Панель бухгалтера</h3>
            <a class="btn btn-sm btn-primary" asp-controller="Reports" asp-action="Index">Отчётность и PDF</a>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-4"><div class="metric-card"><div class="metric-title">Заказов</div><div class="metric-value">@ViewBag.TotalOrders</div></div></div>
            <div class="col-md-4"><div class="metric-card"><div class="metric-title">Выручка</div><div class="metric-value">@(ViewBag.TotalRevenue?.ToString("N2") ?? "0.00") ₽</div></div></div>
            <div class="col-md-4"><div class="metric-card"><div class="metric-title">Клиенты</div><div class="metric-value">@ViewBag.TotalClients</div></div></div>
        </div>

        <div style="max-width: 700px; height: 190px;">
            <canvas id="accountantChart"></canvas>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const monthLabels = @Html.Raw(JsonSerializer.Serialize(ViewBag.MonthLabels));
        const monthRevenue = @Html.Raw(JsonSerializer.Serialize(ViewBag.MonthRevenue));
        const monthOrders = @Html.Raw(JsonSerializer.Serialize(ViewBag.MonthOrders));

        const commonOptions = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'bottom' } }
        };

        @if (User.IsInRole("Директор"))
        {
            <text>
            new Chart(document.getElementById('directorChart'), {
                type: 'line',
                data: {
                    labels: monthLabels,
                    datasets: [{ label: 'Выручка, ₽', data: monthRevenue, borderColor: '#1976D2', tension: 0.3, fill: false }]
                },
                options: commonOptions
            });
            </text>
        }

        @if (User.IsInRole("Менеджер"))
        {
            <text>
            const managerLabels = @Html.Raw(JsonSerializer.Serialize(ViewBag.ShipmentStatusLabels));
            const managerCounts = @Html.Raw(JsonSerializer.Serialize(ViewBag.ShipmentStatusCounts));
            new Chart(document.getElementById('managerChart'), {
                type: 'doughnut',
                data: {
                    labels: managerLabels,
                    datasets: [{ data: managerCounts, backgroundColor: ['#1565C0', '#2E7D32', '#F9A825', '#8E24AA', '#EF6C00'] }]
                },
                options: commonOptions
            });
            </text>
        }

        @if (User.IsInRole("Логист"))
        {
            <text>
            const logisticLabels = @Html.Raw(JsonSerializer.Serialize(ViewBag.ManagerStatusLabels));
            const logisticCounts = @Html.Raw(JsonSerializer.Serialize(ViewBag.ManagerStatusCounts));
            new Chart(document.getElementById('logisticChart'), {
                type: 'bar',
                data: {
                    labels: logisticLabels,
                    datasets: [{ label: 'Заказы по статусам', data: logisticCounts, backgroundColor: '#6A1B9A' }]
                },
                options: commonOptions
            });
            </text>
        }

        @if (User.IsInRole("Сотрудник"))
        {
            <text>
            const employeeLabels = @Html.Raw(JsonSerializer.Serialize(ViewBag.LowStockLabels));
            const employeeCounts = @Html.Raw(JsonSerializer.Serialize(ViewBag.LowStockCounts));
            new Chart(document.getElementById('employeeChart'), {
                type: 'bar',
                data: {
                    labels: employeeLabels,
                    datasets: [{ label: 'Остаток', data: employeeCounts, backgroundColor: '#EF6C00' }]
                },
                options: commonOptions
            });
            </text>
        }

        @if (User.IsInRole("Бухгалтер"))
        {
            <text>
            new Chart(document.getElementById('accountantChart'), {
                type: 'bar',
                data: {
                    labels: monthLabels,
                    datasets: [
                        { label: 'Выручка, ₽', data: monthRevenue, backgroundColor: '#2E7D32' },
                        { label: 'Заказы', data: monthOrders, backgroundColor: '#1565C0' }
                    ]
                },
                options: commonOptions
            });
            </text>
        }
    </script>
}
