@{
    ViewData["Title"] = "Управление оптовыми заказами";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Неизвестно";
}

<div class="hero-panel mb-4">
    <div>
        <h1>Система ведения оптовых заказов аптечной сети</h1>
        <p class="lead mb-2">Единое пространство для продаж, склада, логистики, бухгалтерии и руководства.</p>
        <p class="mb-0">Пользователь: <strong>@ViewBag.UserName</strong> <span class="role-pill">@role</span></p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="metric-card">
            <div class="metric-title">Заказы</div>
            <div class="metric-value">@(ViewBag.TotalOrders ?? 0)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card">
            <div class="metric-title">Выручка</div>
            <div class="metric-value">@(ViewBag.TotalRevenue?.ToString("N2") ?? "0.00") ₽</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card">
            <div class="metric-title">Товарные позиции</div>
            <div class="metric-value">@(ViewBag.TotalProducts ?? 0)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card">
            <div class="metric-title">Клиенты</div>
            <div class="metric-value">@(ViewBag.TotalClients ?? 0)</div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="glass-card p-3 h-100">
            <h3 class="mb-3">Проверка доступа по ролям</h3>
            <div class="table-responsive">
                <table class="table table-modern align-middle">
                    <thead>
                    <tr>
                        <th>Раздел</th>
                        <th>Директор</th>
                        <th>Менеджер</th>
                        <th>Логист</th>
                        <th>Склад</th>
                        <th>Бухгалтер</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr><td>Пользователи и роли</td><td>✅</td><td>—</td><td>—</td><td>—</td><td>—</td></tr>
                    <tr><td>Клиенты</td><td>✅</td><td>✅</td><td>✅</td><td>—</td><td>✅</td></tr>
                    <tr><td>Товары и остатки</td><td>✅</td><td>✅</td><td>✅</td><td>✅</td><td>✅</td></tr>
                    <tr><td>Заказы</td><td>✅</td><td>✅</td><td>✅</td><td>✅</td><td>✅</td></tr>
                    <tr><td>Состав заказов</td><td>✅</td><td>✅</td><td>✅</td><td>✅</td><td>—</td></tr>
                    <tr><td>Логистика и доставка</td><td>✅</td><td>✅</td><td>✅</td><td>—</td><td>—</td></tr>
                    <tr><td>Статусы заказов / поставок</td><td>✅</td><td>✅</td><td>✅</td><td>—</td><td>—</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="glass-card p-3 h-100">
            <h3 class="mb-3">Реализованные потребности</h3>
            <ul class="feature-list">
                <li>Онлайн-остатки товаров и единый реестр заказов.</li>
                <li>Автоматический учет стоимости доставки в заказе.</li>
                <li>Дашборд с KPI: выручка, клиенты, объем заказов.</li>
                <li>Приоритизация задач склада и контроль статусов.</li>
                <li>Единая точка коммуникации между отделами.</li>
                <li>Разграничение прав доступа по ролям сотрудников.</li>
            </ul>
        </div>
    </div>
</div>

<div class="glass-card p-3 mb-4">
    <h3 class="mb-3">Последние заказы</h3>
    @if (ViewBag.RecentOrders != null && ViewBag.RecentOrders.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-modern align-middle">
                <thead>
                <tr>
                    <th>#</th>
                    <th>Дата</th>
                    <th>Клиент</th>
                    <th>Статус</th>
                    <th>Сумма</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var order in ViewBag.RecentOrders)
                {
                    <tr>
                        <td>@order.OrderId</td>
                        <td>@order.OrderDate</td>
                        <td>@(order.Client?.Name ?? "-")</td>
                        <td>@(order.Status?.StatusName ?? "-")</td>
                        <td>@order.TotalPrice</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted mb-0">Пока нет данных по заказам.</p>
    }
</div>
