@{
    ViewData["Title"] = "Главная";
}

<div class="hero-panel mb-4">
    <h1 class="mb-0">Добро пожаловать, @ViewBag.UserName</h1>
</div>

@if (User.IsInRole("Директор"))
{
    <div class="glass-card p-3 mb-4">
        <h3>Дашборд директора</h3>
        <div class="row g-3 mt-1">
            <div class="col-md-3"><div class="metric-card"><div class="metric-title">Выручка</div><div class="metric-value">@(ViewBag.TotalRevenue?.ToString("N2") ?? "0.00") ₽</div></div></div>
            <div class="col-md-3"><div class="metric-card"><div class="metric-title">Сделок за квартал</div><div class="metric-value">@ViewBag.QuarterDeals</div></div></div>
            <div class="col-md-3"><div class="metric-card"><div class="metric-title">Клиенты</div><div class="metric-value">@ViewBag.TotalClients</div></div></div>
            <div class="col-md-3"><div class="metric-card"><div class="metric-title">Товары</div><div class="metric-value">@ViewBag.TotalProducts</div></div></div>
        </div>
        <div class="mt-3">
            @if (ViewBag.WeeklyTopDay != null)
            {
                <p class="mb-2"><strong>Самый прибыльный день недели:</strong> @ViewBag.WeeklyTopDay.Date, @ViewBag.WeeklyTopDay.Revenue.ToString("N2") ₽</p>
            }
            <a class="btn btn-primary btn-sm" asp-controller="Reports" asp-action="Index">Финансовые отчеты</a>
            <a class="btn btn-outline-primary btn-sm" asp-controller="Users" asp-action="Index">Пользователи</a>
        </div>
    </div>
}

@if (User.IsInRole("Менеджер"))
{
    <div class="glass-card p-3 mb-4">
        <h3>Дашборд менеджера по продажам</h3>
        <div class="row g-3 mt-1">
            <div class="col-md-4"><a class="quick-tile" asp-controller="Clients" asp-action="Create">Добавить клиента</a></div>
            <div class="col-md-4"><a class="quick-tile" asp-controller="Orders" asp-action="Create">Создать заказ</a></div>
            <div class="col-md-4"><a class="quick-tile" asp-controller="Products" asp-action="Index">Проверить остатки</a></div>
        </div>
        <p class="text-muted mt-3 mb-0">Автоматизируйте расчёт заказа и передавайте его на склад без звонков.</p>
    </div>
}

@if (User.IsInRole("Логист"))
{
    <div class="glass-card p-3 mb-4">
        <h3>Дашборд логиста</h3>
        <div class="d-flex gap-2 flex-wrap mb-3">
            <a class="btn btn-primary btn-sm" asp-controller="Shipment" asp-action="Index">Поставки</a>
            <a class="btn btn-outline-primary btn-sm" asp-controller="DeliveryMethods" asp-action="Index">Варианты доставки</a>
            <a class="btn btn-outline-primary btn-sm" asp-controller="Orders" asp-action="Index">Заказы к доставке</a>
        </div>
        <div class="table-responsive">
            <table class="table table-modern">
                <thead><tr><th>Дата</th><th>Поставщик</th><th>Статус</th></tr></thead>
                <tbody>
                @foreach (var shipment in ViewBag.ActiveShipments)
                {
                    <tr><td>@shipment.ShipmentDate</td><td>@shipment.Suppliers?.SupplierName</td><td>@shipment.Statussh?.StatusName</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@if (User.IsInRole("Сотрудник"))
{
    <div class="glass-card p-3 mb-4">
        <h3>Дашборд склада</h3>
        <p class="mb-2">План отгрузок на сегодня: <strong>@((ViewBag.TodaysOrders as IEnumerable<dynamic>)?.Count() ?? 0)</strong></p>
        <div class="d-flex gap-2 flex-wrap mb-3">
            <a class="btn btn-primary btn-sm" asp-controller="Orders" asp-action="Index">Заказы на сборку</a>
            <a class="btn btn-outline-primary btn-sm" asp-controller="OrderItems" asp-action="Index">Состав заказов</a>
        </div>
        <h6>Товары с минимальными остатками</h6>
        <ul class="mb-0">
            @foreach (var p in ViewBag.LowStockProducts)
            {
                <li>@p.Name — остаток: @p.Remains</li>
            }
        </ul>
    </div>
}

@if (User.IsInRole("Бухгалтер"))
{
    <div class="glass-card p-3 mb-4">
        <h3>Дашборд бухгалтера</h3>
        <div class="row g-3 mt-1">
            <div class="col-md-4"><div class="metric-card"><div class="metric-title">Всего заказов</div><div class="metric-value">@ViewBag.TotalOrders</div></div></div>
            <div class="col-md-4"><div class="metric-card"><div class="metric-title">Выручка</div><div class="metric-value">@(ViewBag.TotalRevenue?.ToString("N2") ?? "0.00") ₽</div></div></div>
            <div class="col-md-4"><div class="metric-card"><div class="metric-title">Клиенты</div><div class="metric-value">@ViewBag.TotalClients</div></div></div>
        </div>
        <div class="mt-3">
            <a class="btn btn-primary btn-sm" asp-controller="Reports" asp-action="Index">Сформировать отчеты</a>
            <a class="btn btn-outline-primary btn-sm" asp-controller="Orders" asp-action="Index">Реестр заказов</a>
        </div>
    </div>
}
