@{
    ViewData["Title"] = "Авторизация";
}

<div class="access-denied-card" style="max-width:520px;">
    <h2 class="mb-3">Вход в систему</h2>
    <p class="text-muted">Управление оптовыми заказами для розничной аптечной сети.</p>

    <form method="post" class="mt-4">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label class="form-label">Логин</label>
            <input type="text" name="login" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Пароль</label>
            <input type="password" name="password" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary w-100">Войти</button>
    </form>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger mt-3 mb-0">@ViewBag.Error</div>
    }
</div>
