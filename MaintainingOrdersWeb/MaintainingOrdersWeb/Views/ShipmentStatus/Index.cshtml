@model IEnumerable<MaintainingOrdersWeb.Models.ShipmentStatus>

@{
    ViewData["Title"] = "Статусы поставок";
}

<h1 style="color: #1976D2;">Статусы поставок</h1>

@if (User.IsInRole("Директор") || User.IsInRole("Менеджер"))
{
    <p>
        <a asp-action="Create" class="btn btn-success" style="background-color: #2E7D32;">Создать новый статус</a>
    </p>
}
<table class="table table-modern">
    <thead>
        <tr>
            <th>Название статуса</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.StatusName)</td>
                <td>
                    @if (User.IsInRole("Директор") || User.IsInRole("Менеджер"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.StatusId"  class="btn btn-outline-primary btn-sm crud-action-btn">Редактировать</a>
                        <a asp-action="Delete" asp-route-id="@item.StatusId"  class="btn btn-outline-danger btn-sm crud-action-btn">Удалить</a>
                    }
                    <a asp-action="Details" asp-route-id="@item.StatusId"  class="btn btn-outline-info btn-sm crud-action-btn">Детали</a>
                </td>
            </tr>
        }
    </tbody>
</table>