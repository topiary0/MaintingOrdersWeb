@model MaintainingOrdersWeb.Models.OrderStatus

@{
    ViewData["Title"] = "Детали статуса заказа";
}

<h1 class="form-page-title">Детали статуса заказа</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Название</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.StatusName)</dd>
    </dl>
</div>
<div>
    @if (User.IsInRole("Директор"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.StatusId" class="btn btn-primary crud-action-btn">Редактировать</a>
    }
    <a asp-action="Index" class="btn btn-secondary form-nav-btn">Назад к списку</a>
</div>