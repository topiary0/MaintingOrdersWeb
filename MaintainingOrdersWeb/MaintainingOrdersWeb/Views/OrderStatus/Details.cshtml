@model MaintainingOrdersWeb.Models.OrderStatus

@{
    ViewData["Title"] = "Детали статуса заказа";
}

<h1 style="color: #1976D2;">Детали статуса заказа</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Название</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.StatusName)</dd>
    </dl>
</div>
<div>
    @if (User.IsInRole("Директор") || User.IsInRole("Менеджер"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.StatusId" class="btn btn-primary">Редактировать</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
</div>