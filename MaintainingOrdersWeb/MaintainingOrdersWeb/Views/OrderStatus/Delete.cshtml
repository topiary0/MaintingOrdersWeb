@model MaintainingOrdersWeb.Models.OrderStatus

@{
    ViewData["Title"] = "Удаление статуса заказа";
}

<h1 class="form-page-title">Удаление статуса заказа</h1>

<h3 class="delete-confirm-text">Вы уверены, что хотите удалить этот статус?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Название статуса</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.StatusName)</dd>
    </dl>

    <form asp-action="Delete" class="delete-form">
        <input type="hidden" asp-for="StatusId" />
        <input type="submit" value="Удалить" class="btn btn-danger delete-submit-btn" />
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>