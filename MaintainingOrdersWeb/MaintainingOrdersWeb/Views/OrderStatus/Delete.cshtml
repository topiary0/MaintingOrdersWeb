@model MaintainingOrdersWeb.Models.OrderStatus

@{
    ViewData["Title"] = "Удаление статуса заказа";
}

<h1 style="color: #FF6D00;">Удаление статуса заказа</h1>

<h3>Вы уверены, что хотите удалить этот статус?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Название статуса</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.StatusName)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="StatusId" />
        <input type="submit" value="Удалить" class="btn btn-warning" style="background-color: #FF6D00;" />
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>