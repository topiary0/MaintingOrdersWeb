@model MaintainingOrdersWeb.Models.Client

@{
    ViewData["Title"] = "Детали клиента";
}

<h1 style="color: #1976D2;">Детали клиента</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Наименование</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Name)</dd>
        <dt class="col-sm-2">Адрес</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Address)</dd>
        <dt class="col-sm-2">Телефон</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Phone)</dd>
        <dt class="col-sm-2">Контактное лицо</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ContactPerson)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.ClientId" class="btn btn-primary" style="background-color: #1976D2;">Редактировать</a>
    <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
</div>