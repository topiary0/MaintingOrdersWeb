@model MaintainingOrdersWeb.Models.User

@{
    ViewData["Title"] = "Детали пользователя";
}

<h1 class="form-page-title">Детали пользователя</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">ФИО</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FullName)</dd>
        <dt class="col-sm-2">Логин</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Login)</dd>
        <dt class="col-sm-2">Роль</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Role.RoleName)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.UserId" class="btn btn-primary crud-action-btn" >Редактировать</a>
    <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
</div>