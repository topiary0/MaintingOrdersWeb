@model MaintainingOrdersWeb.Models.User

@{
    ViewData["Title"] = "Удаление пользователя";
}

<h1 style="color: #FF6D00;">Удаление пользователя</h1>

<h3>Вы уверены, что хотите удалить этого пользователя?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">ФИО</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FullName)</dd>
        <dt class="col-sm-2">Логин</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Login)</dd>
        <dt class="col-sm-2">Роль</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Role.RoleName)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="UserId" />
        <input type="submit" value="Удалить" class="btn btn-warning" style="background-color: #FF6D00;" />
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>