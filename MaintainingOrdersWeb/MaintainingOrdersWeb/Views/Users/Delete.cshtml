@model MaintainingOrdersWeb.Models.User

@{
    ViewData["Title"] = "Удаление пользователя";
}

<h1 class="form-page-title">Удаление пользователя</h1>

<h3 class="delete-confirm-text">Вы уверены, что хотите удалить этого пользователя?</h3>
<div class="delete-page">
    <dl class="row delete-details">
        <dt class="col-sm-2">ФИО</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FullName)</dd>
        <dt class="col-sm-2">Логин</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Login)</dd>
        <dt class="col-sm-2">Роль</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Role.RoleName)</dd>
    </dl>

    <form asp-action="Delete" class="delete-form">
        <input type="hidden" asp-for="UserId" />
        <input type="submit" value="Удалить" class="btn btn-danger delete-submit-btn" />
        <a asp-action="Index" class="btn btn-secondary form-nav-btn">Отмена</a>
    </form>
</div>