@model MaintainingOrdersWeb.Models.OrderItem

@{
    ViewData["Title"] = "Добавить позицию в заказ";
}

<h1 style="color: #1976D2;">Добавить позицию в заказ</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="OrderId" class="control-label">Заказ №</label>
                <select asp-for="OrderId" class="form-control" asp-items="ViewBag.OrderId"></select>
                <span asp-validation-for="OrderId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="ProductId" class="control-label">Товар</label>
                <select asp-for="ProductId" class="form-control" asp-items="ViewBag.ProductId"></select>
                <span asp-validation-for="ProductId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Quantity" class="control-label">Количество</label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="PriceAtOrder" class="control-label">Цена в заказе</label>
                <input asp-for="PriceAtOrder" class="form-control" step="0.01" lang="en" inputmode="decimal" placeholder="0.00" id="PriceAtOrder" />
                <span asp-validation-for="PriceAtOrder" class="text-danger"></span>
                <small class="text-muted">Вводите с точкой, например 150.50</small>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Добавить" class="btn btn-success" style="background-color: #2E7D32; border-color: #2E7D32;" />
                <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var form = document.querySelector('form');
            if (!form) return;
            form.addEventListener('submit', function() {
                var priceInput = document.getElementById('PriceAtOrder');
                if (priceInput) {
                    var value = priceInput.value;
                    if (value && value.indexOf(',') !== -1) {
                        priceInput.value = value.replace(',', '.');
                    }
                }
            });
        });
    </script>
}