@model MaintainingOrdersWeb.Models.OrderItem

@{
    ViewData["Title"] = "Редактировать позицию заказа";
}

<h1 class="form-page-title">Редактировать позицию заказа</h1>

<hr />
<div class="row">
    <div class="col-md-6 col-lg-5 mx-auto">
        <form asp-action="Edit" asp-route-orderId="@Model.OrderId" asp-route-productId="@Model.ProductId">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="OrderId" />
            <input type="hidden" asp-for="ProductId" />
            <div class="form-group mb-3">
                <label class="control-label">Заказ №</label>
                <input class="form-control" value="@Model.OrderId" disabled />
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Товар</label>
                <input class="form-control" value="@Model.Product?.Name" disabled />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Quantity" class="control-label">Количество</label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="PriceAtOrder" class="control-label">Цена в заказе</label>
                <input asp-for="PriceAtOrder" class="form-control" step="0.01" lang="en" inputmode="decimal" placeholder="0.00" id="PriceAtOrder" />
                <span asp-validation-for="PriceAtOrder" class="text-danger"></span>
                <small class="text-muted">Вводите с точкой, например 150.50</small>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Сохранить" class="btn btn-primary btn-uniform" style="background-color: #1976D2;" />
                <a asp-action="Index" class="btn btn-secondary btn-uniform">Назад к списку</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var form = document.querySelector('form');
            if (!form) return;
            form.addEventListener('submit', function() {
                var priceInput = document.getElementById('PriceAtOrder');
                if (priceInput) {
                    var value = priceInput.value;
                    if (value && value.indexOf(',') !== -1) {
                        priceInput.value = value.replace(',', '.');
                    }
                }
            });
        });
    </script>
}