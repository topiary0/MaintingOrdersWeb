@model IEnumerable<MaintainingOrdersWeb.Models.OrderItem>

@{
    ViewData["Title"] = "Составы заказов";
}

<h1 style="color: #1976D2;">Составы заказов</h1>

@if (User.IsInRole("Директор") || User.IsInRole("Менеджер"))
{
    <p>
        <a asp-action="Create" class="btn btn-success" style="background-color: #2E7D32;">Добавить позицию</a>
    </p>
}
<table class="table table-modern">
    <thead>
        <tr>
            <th>Заказ</th>
            <th>Товар</th>
            <th>Количество</th>
            <th>Цена в заказе</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.OrderId)</td>
                <td>@Html.DisplayFor(modelItem => item.Product.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Quantity)</td>
                <td>@Html.DisplayFor(modelItem => item.PriceAtOrder)</td>
                <td>
                    @if (User.IsInRole("Директор") || User.IsInRole("Менеджер"))
                    {
                        <a asp-action="Edit" asp-route-orderId="@item.OrderId" asp-route-productId="@item.ProductId" class="btn btn-outline-primary btn-sm">Редактировать</a>
                    }
                    @if (User.IsInRole("Директор"))
                    {
                        <a asp-action="Delete" asp-route-orderId="@item.OrderId" asp-route-productId="@item.ProductId" class="btn btn-outline-danger btn-sm">Удалить</a>
                    }
                    <a asp-action="Details" asp-route-orderId="@item.OrderId" asp-route-productId="@item.ProductId" class="btn btn-outline-info btn-sm">Детали</a>
                </td>
            </tr>
        }
    </tbody>
</table>