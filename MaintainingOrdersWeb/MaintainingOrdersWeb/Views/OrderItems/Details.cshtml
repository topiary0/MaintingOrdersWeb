@model MaintainingOrdersWeb.Models.OrderItem

@{
    ViewData["Title"] = "Детали позиции заказа";
}

<h1 class="form-page-title">Детали позиции заказа</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Заказ</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.OrderId)</dd>
        <dt class="col-sm-2">Товар</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Product.Name)</dd>
        <dt class="col-sm-2">Количество</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Quantity)</dd>
        <dt class="col-sm-2">Цена в заказе</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.PriceAtOrder)</dd>
    </dl>
</div>
<div>
    @if (User.IsInRole("Директор") || User.IsInRole("Менеджер"))
    {
        <a asp-action="Edit" asp-route-orderId="@Model?.OrderId" asp-route-productId="@Model?.ProductId" class="btn btn-primary crud-action-btn">Редактировать</a>
    }
    <a asp-action="Index" class="btn btn-secondary btn-uniform">Назад к списку</a>
</div>