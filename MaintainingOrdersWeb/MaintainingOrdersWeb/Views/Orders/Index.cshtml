@model IEnumerable<MaintainingOrdersWeb.Models.Order>

@{
    ViewData["Title"] = "Заказы";
}

<h1 style="color: #1976D2;">Заказы</h1>

@if (User.IsInRole("Директор") || User.IsInRole("Менеджер"))
{
    <p>
        <a asp-action="Create" class="btn btn-success" style="background-color: #2E7D32;">Создать новый заказ</a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>Номер</th>
            <th>Дата</th>
            <th>Клиент</th>
            <th>Статус</th>
            <th>Сумма</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.OrderId</td>
                <td>@item.OrderDate</td>
                <td>@item.Client?.Name</td>
                <td>@item.Status?.StatusName</td>
                <td>@item.TotalPrice</td>
                <td>
                    @if (User.IsInRole("Директор") || User.IsInRole("Менеджер"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.OrderId">Редактировать</a> @:|
                    }
                    @if (User.IsInRole("Директор"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.OrderId">Удалить</a> @:|
                    }
                    <a asp-action="Details" asp-route-id="@item.OrderId">Детали</a>

                    @if (User.IsInRole("Сотрудник") && item.StatusId != 2) 
                    {
                        <form asp-action="MarkAsPacked" asp-route-id="@item.OrderId" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-warning">Собран</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>