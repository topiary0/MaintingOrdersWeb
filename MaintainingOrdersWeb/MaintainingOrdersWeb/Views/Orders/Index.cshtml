@model IEnumerable<MaintainingOrdersWeb.Models.Order>

@{
    ViewData["Title"] = "Заказы";
    var filterDateValue = ViewBag.FilterOrderDate != null ? ((DateOnly)ViewBag.FilterOrderDate).ToString("yyyy-MM-dd") : string.Empty;
}

<h1 style="color: #1976D2;">Заказы</h1>

<div class="glass-card p-3 mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Номер заказа (ID)</label>
            <input type="number" class="form-control" name="orderId" value="@ViewBag.FilterOrderId" min="1" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Клиент</label>
            <select class="form-select" name="clientId">
                <option value="">Все</option>
                @foreach (var client in ViewBag.Clients)
                {
                    if (ViewBag.FilterClientId != null && (int)ViewBag.FilterClientId == client.ClientId)
                    {
                        <option value="@client.ClientId" selected>@client.Name</option>
                    }
                    else
                    {
                        <option value="@client.ClientId">@client.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Дата</label>
            <input type="date" class="form-control" name="orderDate" value="@filterDateValue" />
        </div>
        <div class="col-md-2 d-grid gap-2">
            <button type="submit" class="btn btn-primary btn-uniform">Поиск</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-uniform">Сброс</a>
        </div>
    </form>
</div>

@if (User.IsInRole("Директор") || User.IsInRole("Менеджер"))
{
    <p>
        <a asp-action="Create" class="btn btn-success btn-uniform" style="background-color: #2E7D32;">Создать новый заказ</a>
    </p>
}
<table class="table table-modern">
    <thead>
        <tr>
            <th>Номер</th>
            <th>Дата</th>
            <th>Клиент</th>
            <th>Статус</th>
            <th>Сумма</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.OrderId</td>
                <td>@item.OrderDate</td>
                <td>@item.Client?.Name</td>
                <td>@item.Status?.StatusName</td>
                <td>@item.TotalPrice</td>
                <td>
                    @if (User.IsInRole("Директор") || User.IsInRole("Менеджер"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.OrderId" class="btn btn-outline-primary btn-sm crud-action-btn">Редактировать</a>
                    }
                    @if (User.IsInRole("Директор") || User.IsInRole("Менеджер"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.OrderId" class="btn btn-outline-danger btn-sm crud-action-btn">Удалить</a>
                    }
                    <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-outline-info btn-sm crud-action-btn">Детали</a>
                    <a asp-controller="OrderItems" asp-action="Index" asp-route-orderId="@item.OrderId" class="btn btn-outline-secondary btn-sm crud-action-btn">Состав</a>

                    @if (User.IsInRole("Сотрудник") && item.StatusId != 2)
                    {
                        <form asp-action="MarkAsPacked" asp-route-id="@item.OrderId" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Отметить как собран</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
