@model MaintainingOrdersWeb.Models.Shipment

@{
    ViewData["Title"] = "Редактировать поставку";
}

<h1 style="color: #1976D2;">Редактировать поставку</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ShipmentId" />
            <div class="form-group">
                <label asp-for="ShipmentDate" class="control-label">Дата поставки</label>
                <input asp-for="ShipmentDate" class="form-control" type="date" />
                <span asp-validation-for="ShipmentDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label">Статус (текст)</label>
                <input asp-for="Status" class="form-control" />
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SuppliersId" class="control-label">Поставщик</label>
                <select asp-for="SuppliersId" class="form-control" asp-items="ViewBag.SuppliersId"></select>
            </div>
            <div class="form-group">
                <label asp-for="UserId" class="control-label">Менеджер</label>
                <select asp-for="UserId" class="form-control" asp-items="ViewBag.UserId"></select>
            </div>
            <div class="form-group">
                <label asp-for="StatusshId" class="control-label">Статус поставки</label>
                <select asp-for="StatusshId" class="form-control" asp-items="ViewBag.StatusshId"></select>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Сохранить" class="btn btn-primary" style="background-color: #1976D2;" />
                <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}