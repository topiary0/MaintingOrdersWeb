@model MaintainingOrdersWeb.Models.Supplier

@{
    ViewData["Title"] = "Редактировать поставщика";
}

<h1 class="form-page-title">Редактировать поставщика</h1>

<hr />
<div class="row">
    <div class="col-md-6 col-lg-5 mx-auto">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="SuppliersId" />
            <div class="form-group mb-3">
                <label asp-for="SupplierName" class="control-label">Наименование поставщика</label>
                <input asp-for="SupplierName" class="form-control" />
                <span asp-validation-for="SupplierName" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Address" class="control-label">Адрес</label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="ContactInfo" class="control-label">Контактная информация</label>
                <input asp-for="ContactInfo" class="form-control" />
                <span asp-validation-for="ContactInfo" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Сохранить" class="btn btn-primary btn-uniform" style="background-color: #1976D2;" />
                <a asp-action="Index" class="btn btn-secondary btn-uniform">Назад к списку</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}