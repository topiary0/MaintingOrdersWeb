@model MaintainingOrdersWeb.Models.Supplier

@{
    ViewData["Title"] = "Удаление поставщика";
}

<h1 style="color: #FF6D00;">Удаление поставщика</h1>

<h3>Вы уверены, что хотите удалить этого поставщика?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Наименование</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.SupplierName)</dd>
        <dt class="col-sm-2">Адрес</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Address)</dd>
        <dt class="col-sm-2">Контактная информация</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ContactInfo)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="SuppliersId" />
        <input type="submit" value="Удалить" class="btn btn-warning" style="background-color: #FF6D00;" />
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>