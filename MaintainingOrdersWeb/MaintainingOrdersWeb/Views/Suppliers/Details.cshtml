@model MaintainingOrdersWeb.Models.Supplier

@{
    ViewData["Title"] = "Детали поставщика";
}

<h1 class="form-page-title">Детали поставщика</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Наименование</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.SupplierName)</dd>
        <dt class="col-sm-2">Адрес</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Address)</dd>
        <dt class="col-sm-2">Контактная информация</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ContactInfo)</dd>
    </dl>
</div>
<div>
    @if (User.IsInRole("Директор"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.SuppliersId" class="btn btn-primary crud-action-btn">Редактировать</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
</div>