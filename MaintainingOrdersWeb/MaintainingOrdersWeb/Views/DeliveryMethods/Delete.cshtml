@model MaintainingOrdersWeb.Models.DeliveryMethod

@{
    var canDelete = ViewBag.CanDelete as bool? ?? true;
    ViewData["Title"] = "Удаление способа доставки";
}

<h1 class="form-page-title">Удаление способа доставки</h1>

<h3 class="delete-confirm-text">Вы уверены, что хотите удалить этот способ доставки?</h3>
<div>
    <partial name="_DeleteDependencyWarning" />
    <dl class="row">
        <dt class="col-sm-2">Название</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.MethodName)</dd>
        <dt class="col-sm-2">Цена</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Price)</dd>
        <dt class="col-sm-2">Примерное время</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.EstimatedTime)</dd>
    </dl>

    <form asp-action="Delete" class="delete-form">
        <input type="hidden" asp-for="MethodId" />
        @if (canDelete)
        {
            <input type="submit" value="Удалить" class="btn btn-danger delete-submit-btn btn-uniform" />
        }
        else
        {
            <button type="button" class="btn btn-warning delete-submit-btn btn-uniform" disabled>Удаление недоступно</button>
        }
        <a asp-action="Index" class="btn btn-secondary btn-uniform">Назад к списку</a>
    </form>
</div>