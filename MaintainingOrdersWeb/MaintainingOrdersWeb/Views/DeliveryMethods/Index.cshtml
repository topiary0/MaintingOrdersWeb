@model IEnumerable<MaintainingOrdersWeb.Models.DeliveryMethod>

@{
    ViewData["Title"] = "Способы доставки";
}

<h1 style="color: #1976D2;">Способы доставки</h1>

@if (TempData["DeliveryMethodError"] is string err)
{
    <div class="alert alert-warning">@err</div>
}

@if (User.IsInRole("Директор") || User.IsInRole("Менеджер") || User.IsInRole("Логист"))
{
    <p>
        <a asp-action="Create" class="btn btn-success btn-uniform" style="background-color: #2E7D32;">Создать новый способ</a>
    </p>
}
<table class="table table-modern">
    <thead>
        <tr>
            <th>Название</th>
            <th>Цена</th>
            <th>Примерное время</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.MethodName)</td>
                <td>@Html.DisplayFor(modelItem => item.Price)</td>
                <td>@Html.DisplayFor(modelItem => item.EstimatedTime)</td>
                <td>
                    @if (User.IsInRole("Директор") || User.IsInRole("Менеджер") || User.IsInRole("Логист"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.MethodId"  class="btn btn-outline-primary btn-sm crud-action-btn">Редактировать</a>
                        <a asp-action="Delete" asp-route-id="@item.MethodId"  class="btn btn-outline-danger btn-sm crud-action-btn">Удалить</a>
                    }
                    <a asp-action="Details" asp-route-id="@item.MethodId"  class="btn btn-outline-info btn-sm crud-action-btn">Детали</a>
                </td>
            </tr>
        }
    </tbody>
</table>