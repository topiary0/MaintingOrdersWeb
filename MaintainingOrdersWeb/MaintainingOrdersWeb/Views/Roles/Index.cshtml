@model IEnumerable<MaintainingOrdersWeb.Models.Role>

@{
    ViewData["Title"] = "Роли";
}

<h1 style="color: #1976D2;">Роли</h1>

<p>
    <a asp-action="Create" class="btn btn-success" style="background-color: #2E7D32; border-color: #2E7D32;">Создать новую роль</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Название роли</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.RoleName)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.RoleId" style="color: #1976D2;">Редактировать</a> |
                    <a asp-action="Details" asp-route-id="@item.RoleId" style="color: #1976D2;">Детали</a> |
                    <a asp-action="Delete" asp-route-id="@item.RoleId" style="color: #FF6D00;">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>