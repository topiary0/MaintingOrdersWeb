@model MaintainingOrdersWeb.Models.Role

@{
    ViewData["Title"] = "Удаление роли";
}

<h1 class="form-page-title">Удаление роли</h1>

<h3 class="delete-confirm-text">Вы уверены, что хотите удалить эту роль?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Название роли</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.RoleName)</dd>
    </dl>

    <form asp-action="Delete" class="delete-form">
        <input type="hidden" asp-for="RoleId" />
        <input type="submit" value="Удалить" class="btn btn-danger delete-submit-btn btn-uniform" />
        <a asp-action="Index" class="btn btn-secondary btn-uniform">Отмена</a>
    </form>
</div>