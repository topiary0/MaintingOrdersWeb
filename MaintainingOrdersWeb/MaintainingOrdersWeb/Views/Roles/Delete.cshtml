@model MaintainingOrdersWeb.Models.Role

@{
    ViewData["Title"] = "Удаление роли";
}

<h1 style="color: #FF6D00;">Удаление роли</h1>

<h3>Вы уверены, что хотите удалить эту роль?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Название роли</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.RoleName)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="RoleId" />
        <input type="submit" value="Удалить" class="btn btn-warning" style="background-color: #FF6D00;" />
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>