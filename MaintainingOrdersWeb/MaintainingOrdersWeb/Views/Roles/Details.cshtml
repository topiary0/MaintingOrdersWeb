@model MaintainingOrdersWeb.Models.Role

@{
    ViewData["Title"] = "Детали роли";
}

<h1 class="form-page-title">Детали роли</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Название роли</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.RoleName)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.RoleId" class="btn btn-primary crud-action-btn" >Редактировать</a>
    <a asp-action="Index" class="btn btn-secondary form-nav-btn">Назад к списку</a>
</div>