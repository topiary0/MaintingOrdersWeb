@model MaintainingOrdersWeb.Models.SupplyItem

@{
    ViewData["Title"] = "Удаление элемента поставки";
}

<h1 style="color: #FF6D00;">Удаление элемента поставки</h1>

<h3>Вы уверены, что хотите удалить этот элемент?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Поставка (ID)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ShipmentId)</dd>
        <dt class="col-sm-2">Товар</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Product.Name)</dd>
        <dt class="col-sm-2">Количество</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Quantity)</dd>
        <dt class="col-sm-2">Цена в поставке</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.PriceAtShipment)</dd>
    </dl>

    <form asp-action="Delete" asp-route-shipmentId="@Model.ShipmentId" asp-route-productId="@Model.ProductId">
        <input type="submit" value="Удалить" class="btn btn-warning" style="background-color: #FF6D00;" />
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>