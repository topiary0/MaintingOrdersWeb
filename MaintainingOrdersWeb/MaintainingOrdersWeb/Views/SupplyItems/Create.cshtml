@model MaintainingOrdersWeb.Models.SupplyItem

@{
    ViewData["Title"] = "Добавить товар в поставку";
}

<h1 style="color: #1976D2;">Добавить товар в поставку</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ShipmentId" class="control-label">Поставка (ID)</label>
                <select asp-for="ShipmentId" class="form-control" asp-items="ViewBag.ShipmentId"></select>
                <span asp-validation-for="ShipmentId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ProductId" class="control-label">Товар</label>
                <select asp-for="ProductId" class="form-control" asp-items="ViewBag.ProductId"></select>
                <span asp-validation-for="ProductId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Quantity" class="control-label">Количество</label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PriceAtShipment" class="control-label">Цена в поставке</label>
                <input asp-for="PriceAtShipment" class="form-control" step="0.01" lang="en" inputmode="decimal" placeholder="0.00" id="PriceAtShipment" />
                <span asp-validation-for="PriceAtShipment" class="text-danger"></span>
                <small class="text-muted">Вводите с точкой, например 350.00</small>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Создать" class="btn btn-success" style="background-color: #2E7D32; border-color: #2E7D32;" />
                <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var form = document.querySelector('form');
            form.addEventListener('submit', function() {
                var priceInput = document.getElementById('PriceAtShipment');
                if (priceInput && priceInput.value.indexOf(',') !== -1) {
                    priceInput.value = priceInput.value.replace(',', '.');
                }
            });
        });
    </script>
}