@model MaintainingOrdersWeb.Models.SupplyItem

@{
    ViewData["Title"] = "Редактировать элемент поставки";
}

<h1 class="form-page-title">Редактировать элемент поставки</h1>

<hr />
<div class="row">
    <div class="col-md-6 col-lg-5 mx-auto">
        <form asp-action="Edit" asp-route-shipmentId="@Model.ShipmentId" asp-route-productId="@Model.ProductId">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ShipmentId" />
            <input type="hidden" asp-for="ProductId" />
            <div class="form-group mb-3">
                <label asp-for="Quantity" class="control-label">Количество</label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="PriceAtShipment" class="control-label">Цена в поставке</label>
                <input asp-for="PriceAtShipment" class="form-control" step="0.01" lang="en" inputmode="decimal" placeholder="0.00" id="PriceAtShipment" />
                <span asp-validation-for="PriceAtShipment" class="text-danger"></span>
                <small class="text-muted">Вводите с точкой, например 350.00</small>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Сохранить" class="btn btn-primary btn-uniform" style="background-color: #1976D2;" />
                <a asp-action="Index" class="btn btn-secondary btn-uniform">Назад к списку</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var form = document.querySelector('form');
            form.addEventListener('submit', function() {
                var priceInput = document.getElementById('PriceAtShipment');
                if (priceInput && priceInput.value.indexOf(',') !== -1) {
                    priceInput.value = priceInput.value.replace(',', '.');
                }
            });
        });
    </script>
}