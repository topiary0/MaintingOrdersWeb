@model IEnumerable<MaintainingOrdersWeb.Models.User>

@{
    ViewData["Title"] = "Пользователи";
}

<h1 style="color: #1976D2;">Пользователи</h1>

<p>
    <a asp-action="Create" class="btn btn-success" style="background-color: #2E7D32; border-color: #2E7D32;">Создать нового</a>
</p>
<table class="table table-modern">
    <thead>
        <tr>
            <th>ФИО</th>
            <th>Логин</th>
            <th>Роль</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.FullName)</td>
                <td>@Html.DisplayFor(modelItem => item.Login)</td>
                <td>@Html.DisplayFor(modelItem => item.Role.RoleName)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.UserId"  class="btn btn-outline-primary btn-sm crud-action-btn">Редактировать</a>
                    <a asp-action="Details" asp-route-id="@item.UserId"  class="btn btn-outline-info btn-sm crud-action-btn">Детали</a>
                    <a asp-action="Delete" asp-route-id="@item.UserId"  class="btn btn-outline-danger btn-sm crud-action-btn">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>