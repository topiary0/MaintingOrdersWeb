@model MaintainingOrdersWeb.Models.Shipment

@{
    ViewData["Title"] = "Создать поставку";
}

<h1 class="form-page-title">Создать поставку</h1>

<hr />
<div class="row">
    <div class="col-md-6 col-lg-5 mx-auto">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="ShipmentDate" class="control-label">Дата поставки</label>
                <input asp-for="ShipmentDate" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="ShipmentDate" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="SuppliersId" class="control-label">Поставщик</label>
                <select asp-for="SuppliersId" class="form-control" asp-items="ViewBag.SuppliersId"></select>
            </div>
            <div class="form-group mb-3">
                <label asp-for="UserId" class="control-label">Менеджер</label>
                <select asp-for="UserId" class="form-control" asp-items="ViewBag.UserId"></select>
            </div>
            <div class="form-group mb-3">
                <label asp-for="StatusshId" class="control-label">Статус поставки</label>
                <select asp-for="StatusshId" class="form-control" asp-items="ViewBag.StatusshId"></select>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Создать" class="btn btn-success" style="background-color: #2E7D32; border-color: #2E7D32;" />
                <a asp-action="Index" class="btn btn-secondary btn-uniform">Назад к списку</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}