@model MaintainingOrdersWeb.Models.Supplier

@{
    var canDelete = ViewBag.CanDelete as bool? ?? true;
    ViewData["Title"] = "Удаление поставщика";
}

<h1 class="form-page-title">Удаление поставщика</h1>

<h3 class="delete-confirm-text">Вы уверены, что хотите удалить этого поставщика?</h3>
<div>
    <partial name="_DeleteDependencyWarning" />
    <dl class="row">
        <dt class="col-sm-2">Наименование</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.SupplierName)</dd>
        <dt class="col-sm-2">Адрес</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Address)</dd>
        <dt class="col-sm-2">Контактная информация</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ContactInfo)</dd>
    </dl>

    <form asp-action="Delete" class="delete-form">
        <input type="hidden" asp-for="SuppliersId" />
        @if (canDelete)
        {
            <input type="submit" value="Удалить" class="btn btn-danger delete-submit-btn btn-uniform" />
        }
        else
        {
            <button type="button" class="btn btn-warning delete-submit-btn btn-uniform" disabled>Удаление недоступно</button>
        }
        <a asp-action="Index" class="btn btn-secondary btn-uniform">Отмена</a>
    </form>
</div>