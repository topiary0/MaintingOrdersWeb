@model MaintainingOrdersWeb.Models.ShipmentStatus

@{
    ViewData["Title"] = "Детали статуса поставки";
}

<h1 class="form-page-title">Детали статуса поставки</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Название статуса</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.StatusName)</dd>
    </dl>
</div>
<div>
    @if (User.IsInRole("Директор"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.StatusId" class="btn btn-primary crud-action-btn" >Редактировать</a>
    }
    <a asp-action="Index" class="btn btn-secondary btn-uniform">Назад к списку</a>
</div>